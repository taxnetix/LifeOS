#!/usr/bin/env bash
# LifeOS pre-commit guard — the HARD control on vault leakage.
#
# .gitignore is advisory: `git add -f`, an edited .gitignore or `git stash -u`
# each defeat it, and git history cannot be un-rung. This hook is the control
# that is not advisory.  Install with: bash tools/scripts/install-hooks.sh
#
# NEVER bypass this with --no-verify.
# See docs/adr/0008-vault-location-and-separation.md
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
VAULT_DIRNAME="$(basename "${LIFEOS_VAULT:-$REPO/vault}")"
fail=0

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[[ -z "$staged" ]] && exit 0

# ── 1. No staged path inside the vault ───────────────────────────────────────
vault_hits="$(echo "$staged" | grep -E "^(${VAULT_DIRNAME}|vault)/" || true)"
if [[ -n "$vault_hits" ]]; then
  echo "REFUSED: these staged paths are inside the vault:" >&2
  echo "$vault_hits" | sed 's/^/    /' >&2
  echo "" >&2
  echo "  The vault never enters this repo's history. Unstage them:" >&2
  echo "      git restore --staged $(echo "$vault_hits" | head -1)" >&2
  fail=1
fi

# ── 2. No personal-data patterns in staged content ───────────────────────────
diff_text="$(git diff --cached --diff-filter=ACMR -U0 | grep '^+' | grep -v '^+++' || true)"

if [[ -n "$diff_text" ]]; then
  # SA ID number: YYMMDD SSSS C A Z
  if echo "$diff_text" | grep -Eq '\b[0-9]{6}[0-5][0-9]{3}[01][0-9]{2}\b'; then
    echo "REFUSED: staged content contains something shaped like an SA ID number." >&2
    fail=1
  fi
  # Long digit runs — account / policy / member numbers
  if echo "$diff_text" | grep -Eq '\b[0-9]{11,16}\b'; then
    echo "REFUSED: staged content contains a long digit run (account/policy number?)." >&2
    fail=1
  fi
  # Credentials
  if echo "$diff_text" | grep -Eqi 'password[[:space:]]*[:=]|api[_-]?key[[:space:]]*[:=]|BEGIN [A-Z ]*PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{20,}'; then
    echo "REFUSED: staged content looks like it contains a credential." >&2
    fail=1
  fi
fi

# ── 3. No proper names from the live profile ─────────────────────────────────
PROFILE="${LIFEOS_VAULT:-$REPO/vault}/profile/profile.yaml"
if [[ -f "$PROFILE" && -n "$diff_text" ]]; then
  while read -r name; do
    [[ ${#name} -lt 4 ]] && continue
    if echo "$diff_text" | grep -Fqi -- "$name"; then
      echo "REFUSED: staged content contains a name from your profile." >&2
      echo "         (the name itself is not printed here, on purpose)" >&2
      fail=1
      break
    fi
  done < <(grep -Eo '^[[:space:]]*-?[[:space:]]*(full_name|legal_name|trading_name):.*' "$PROFILE" 2>/dev/null \
             | sed 's/.*: *//' | tr -d '"'"'" | tr ' ' '\n' | sort -u)
fi

if [[ "$fail" -ne 0 ]]; then
  echo "" >&2
  echo "  Definition of done #6: nothing personal has EVER entered this repo's history." >&2
  echo "  Do not use --no-verify. Fix the commit instead." >&2
  exit 1
fi

exit 0

# ─────────────────────────────────────────────────────────────────────────────
#  THE VAULT — real personal data. Never committed. Ever.
#
#  This entry is advisory: `git add -f`, an edited .gitignore, or `git stash -u`
#  would each defeat it, and git history cannot be un-rung.  The pre-commit hook
#  at .claude/hooks/pre-commit is the HARD control.  Install it with:
#      bash tools/scripts/install-hooks.sh
#  Never bypass it with --no-verify.       See docs/adr/0008-*.md
# ─────────────────────────────────────────────────────────────────────────────
vault/
vault-*/
*.vault/

# Anything a user marks local
*.local
*.local.*

# ─── vault.example: sources are committed, derived artefacts are not ─────────
#  Everything below is reproducible from vault.example/inbox/ + profile.yaml by
#  running /ingest and /life-file. That is the same "every derived artefact must
#  be reproducible from source documents plus config" rule the real vault obeys,
#  and it keeps regenerated PDFs out of the diff.
vault.example/documents/2*/
vault.example/documents/index.jsonl
vault.example/reports/
vault.example/state/*.json
vault.example/state/*.jsonl
vault.example/ledgers/*.jsonl
vault.example/proposed/low-confidence/
vault.example/proposed/rejected/

# ─── Python ──────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
requirements.lock.txt

# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store

# ─── Editors ─────────────────────────────────────────────────────────────────
.idea/
*.swp

# ─── Claude Code local overrides ─────────────────────────────────────────────
.claude/settings.local.json

{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LifeOS — a personal life-management system implemented entirely as a Claude Code agentic system. Node owns the presentation and validation plane only; see docs/adr/0011-python-primary-thin-node.md.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"tools/js/**/*.{mjs,js,json}\"",
    "format:check": "prettier --check \"tools/js/**/*.{mjs,js,json}\"",
    "validate": "node tools/js/validate-schema.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}

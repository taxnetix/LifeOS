{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/schemas/envelope.schema.json",
  "title": "LifeOS record envelope",
  "description": "Shared by every record in every ledger. See docs/data-dictionary.md §2 and ADR-0006/0014.",

  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },

    "originHash": {
      "description": "A document hash, or an explicit non-document origin.",
      "oneOf": [
        { "$ref": "#/$defs/hash" },
        { "type": "string", "enum": ["human", "inferred"] }
      ]
    },

    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },

    "instant": {
      "type": "string",
      "format": "date-time"
    },

    "personRef": { "type": "string", "pattern": "^per_[a-z0-9_]+$" },
    "entityRef": { "type": "string", "pattern": "^ent_[a-z0-9_]+$" },
    "accountRef": { "type": "string", "pattern": "^acc_[a-z0-9_]+$" },
    "policyRef": { "type": "string", "pattern": "^pol_[a-z0-9_]+$" },
    "holdingRef": { "type": "string", "pattern": "^hol_[a-z0-9_]+$" },
    "assetRef": { "type": "string", "pattern": "^ast_[a-z0-9_]+$" },
    "trustRef": { "type": "string", "pattern": "^tr_[a-z0-9_]+$" },

    "subjectRef": {
      "description": "Any person or entity.",
      "oneOf": [
        { "$ref": "#/$defs/personRef" },
        { "$ref": "#/$defs/entityRef" }
      ]
    },

    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217. Required — there is no default."
    },

    "money": {
      "type": "object",
      "description": "Integer minor units plus a currency. NEVER a float — see ADR-0005.",
      "properties": {
        "cents": {
          "type": "integer",
          "description": "Signed. Negative is outflow. Integer only; a float fails validation and is never written."
        },
        "currency": { "$ref": "#/$defs/currency" }
      },
      "required": ["cents", "currency"],
      "additionalProperties": false
    },

    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "A rate, not money. Percentages are never stored as money objects."
    },

    "contact": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["email", "mobile", "landline", "postal", "physical", "other"]
        },
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string" }
      },
      "required": ["kind", "value"],
      "additionalProperties": false
    },

    "source": {
      "type": "object",
      "description": "Where this record came from. Required on every record — ADR-0014.",
      "properties": {
        "doc_hash": { "$ref": "#/$defs/originHash" },
        "locator": {
          "type": "string",
          "minLength": 1,
          "description": "Exact position within the origin: 'page=3;row=17', 'sheet=Summary;cell=B14', 'para=12'."
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "description": "Tool and version that produced it: 'parser:absa-cheque/2', 'pdfplumber', 'ocr:tesseract', 'llm-extract', 'human', 'inferred'. Values of 'llm-extract' and 'inferred' are rendered differently in reports."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Below the ledger's floor the record goes to proposed/, not to the ledger."
        },
        "extracted_at": { "$ref": "#/$defs/instant" }
      },
      "required": ["doc_hash", "locator", "method", "confidence", "extracted_at"],
      "additionalProperties": false
    },

    "meta": {
      "type": "object",
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "The sole writer of this ledger — ADR-0007."
        },
        "written_at": { "$ref": "#/$defs/instant" }
      },
      "required": ["run_id", "agent", "written_at"],
      "additionalProperties": false
    },

    "base": {
      "type": "object",
      "description": "The envelope every ledger record composes with allOf.",
      "properties": {
        "id": {
          "$ref": "#/$defs/hash",
          "description": "sha256(doc_hash|locator|natural_key). Deterministic — re-ingestion is a no-op. ADR-0006."
        },
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[0-9]+$",
          "description": "'<ledger>/<major>'. Major only; a bump needs an ADR and a migration. ADR-0012."
        },
        "subject_id": { "$ref": "#/$defs/subjectRef" },
        "entity_id": {
          "$ref": "#/$defs/entityRef",
          "description": "Owning entity when different from the subject — separates business from personal."
        },
        "source": { "$ref": "#/$defs/source" },
        "valid_from": {
          "$ref": "#/$defs/date",
          "description": "When the fact became true in the world."
        },
        "valid_to": {
          "description": "null means still true.",
          "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
        },
        "superseded_by": {
          "description": "Set by a later correction. Records are never mutated.",
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "_meta": { "$ref": "#/$defs/meta" }
      },
      "required": [
        "id",
        "schema",
        "subject_id",
        "source",
        "valid_from",
        "valid_to",
        "superseded_by",
        "_meta"
      ]
    }
  },

  "$ref": "#/$defs/base"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/schemas/ledgers/policies.schema.json",
  "title": "policies/1",
  "description": "All insurance. Owner: insurance. PII: high (policy numbers).",
  "allOf": [{ "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/base" }],
  "properties": {
    "ref": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/policyRef" },
    "class": {
      "type": "string",
      "enum": [
        "life",
        "disability",
        "income_protection",
        "dread_disease",
        "funeral",
        "short_term",
        "business"
      ]
    },
    "subclass": {
      "type": "string",
      "description": "short_term: contents | buildings | vehicle | all_risk | portable_possessions | liability | cyber. business: key_person | buy_and_sell | contingent_liability | overheads | professional_indemnity."
    },
    "insurer": { "type": "string", "minLength": 1 },
    "policy_no": { "type": "string", "description": "PII: high." },
    "life_assured_ref": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/personRef" },
    "owner_ref": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/subjectRef" },
    "premium": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/money" },
    "premium_frequency": {
      "type": "string",
      "enum": ["monthly", "quarterly", "annual", "single"]
    },
    "escalation_pct": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/percent" },
    "sum_assured": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/money" },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "person_ref": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/personRef" },
          "name": { "type": "string" },
          "pct": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/percent" }
        },
        "required": ["pct"],
        "additionalProperties": false
      }
    },
    "cession": {
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "kind": { "type": "string", "enum": ["security", "outright"] },
        "doc_hash": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/hash" }
      },
      "required": ["to", "kind"],
      "additionalProperties": false
    },
    "waiting_periods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "months": { "type": "integer", "minimum": 0 }
        },
        "required": ["kind", "months"],
        "additionalProperties": false
      }
    },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "broker": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contact": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/contact" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "inception_on": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/date" },
    "anniversary_on": {
      "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/date",
      "description": "Drives the 45-day quote-refresh lead — C9f."
    },
    "deemed_property_s3_3_a_ii": {
      "type": "boolean",
      "description": "Whether proceeds are deemed property in the estate under s3(3)(a)(ii) — C9e. Affects estate duty."
    },
    "doc_hash": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/hash" }
  },
  "required": ["ref", "class", "insurer", "owner_ref"],
  "unevaluatedProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/schemas/ledgers/tax-events.schema.json",
  "title": "tax-events/1",
  "description": "Tax documents, returns and events. Owner: tax. PII: high.",
  "allOf": [{ "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/base" }],
  "properties": {
    "ref": { "type": "string", "minLength": 1 },
    "taxpayer_ref": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/subjectRef" },
    "tax_year": { "type": "string", "pattern": "^\\d{4}$" },
    "kind": {
      "type": "string",
      "enum": [
        "itr12",
        "itr14",
        "it12tr",
        "irp5",
        "it3a",
        "it3b",
        "it3c",
        "cgt",
        "donation",
        "dividends_tax",
        "logbook",
        "assessment",
        "other"
      ]
    },
    "amount": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/money" },
    "status": {
      "type": "string",
      "enum": ["expected", "received", "filed", "assessed", "paid", "disputed"]
    },
    "filed_on": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/date" },
    "assessed_on": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/date" },
    "counterparty": { "type": "string", "description": "Employer, platform or payer." },
    "rule_ref": {
      "type": "string",
      "description": "Rulebook consulted, e.g. 'za/sars-tables@2026-03-01'. Carries the 'as at' date into the record."
    },
    "doc_hash": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/hash" }
  },
  "required": ["ref", "taxpayer_ref", "tax_year", "kind", "status"],
  "unevaluatedProperties": false
}

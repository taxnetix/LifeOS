{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeos.local/schemas/ledgers/transactions.schema.json",
  "title": "transactions/1",
  "description": "The largest ledger. Owner: finance. Confidence below profile.finance.category_floor means the transaction lands UNCATEGORISED with a question, never guessed into a bucket.",
  "allOf": [{ "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/base" }],
  "properties": {
    "account_ref": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/accountRef" },
    "posted_on": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/date" },
    "value_on": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/date" },
    "description_raw": {
      "type": "string",
      "minLength": 1,
      "description": "Exactly as printed on the statement. Never edited — it is part of the natural key."
    },
    "description_clean": { "type": "string" },
    "amount": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/money" },
    "balance_after": { "$ref": "https://lifeos.local/schemas/envelope.schema.json#/$defs/money" },
    "category": { "type": "string" },
    "subcategory": { "type": "string" },
    "counterparty": { "type": "string" },
    "is_recurring": { "type": "boolean" },
    "recurring_ref": { "type": "string" },
    "tax_relevance": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "deductible",
          "medical",
          "retirement",
          "rental_income",
          "rental_expense",
          "home_office",
          "travel",
          "donation",
          "business_expense",
          "cgt_event",
          "none"
        ]
      }
    },
    "category_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "category_method": {
      "type": "string",
      "enum": ["rule", "history", "llm", "human"]
    }
  },
  "required": ["account_ref", "posted_on", "description_raw", "amount"],
  "unevaluatedProperties": false
}
